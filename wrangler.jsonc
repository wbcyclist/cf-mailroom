{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Resource names identify this deployment; every instance chooses its own.
  "name": "mailroom",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Publish the workers.dev hostname and put Cloudflare Access on this Worker.
  // Preview URLs are separate hostnames, so keep them off.
  "workers_dev": true,
  "preview_urls": false,
  // Preserve per-instance WEB_ACCESS_TEAM_DOMAIN and WEB_ACCESS_AUD from
  // Worker Settings > Variables and Secrets. Missing values deny all API access.
  "keep_vars": true,
  "assets": {
    "not_found_handling": "single-page-application",
    // /mcp (including /mcp/oauth/*) and /.well-known/* serve MCP and OAuth;
    // /authorize is owner consent.
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/.well-known/*",
      "/authorize",
      "/cdn-cgi/handler/email"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace with the ID of a Hyperdrive config with query caching disabled.
      "id": "00000000000000000000000000000000"
    }
  ],
  "kv_namespaces": [
    {
      // MCP OAuth clients, grants, and tokens. No ID: Wrangler creates the
      // namespace on first deploy and reuses it afterwards.
      "binding": "OAUTH_KV"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      // Sender domains must be onboarded to Email Service (dashboard > Email Service).
      "name": "EMAIL"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DRAFT_QUEUE",
        "queue": "mailroom-drafts"
      },
      {
        // Declare the DLQ as a binding so template deployments provision it too.
        // The consumer below routes exhausted retries here; app code does not send to it.
        "binding": "DRAFT_DLQ",
        "queue": "mailroom-drafts-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "mailroom-drafts",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "mailroom-drafts-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
